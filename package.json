{
  "name": "svnx",
  "version": "0.1.19",
  "private": true,
  "description": "A focused Subversion desktop client",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/desktop.mjs",
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "build": "node scripts/file-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pack": "npm run build && electron-builder --win --dir",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && npm run build:portable-splash && node tests/desktop.mjs && node tests/desktop-tree.mjs && node tests/desktop-history.mjs && node tests/desktop-layout.mjs && node tests/desktop-commit-recovery.mjs && node tests/desktop-merge.mjs && node tests/native-startup.mjs && node tests/desktop-startup.mjs",
    "build:icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "format": "prettier --write src electron scripts tests",
    "build:portable-splash": "powershell -NoProfile -File scripts/build-native-splash.ps1",
    "dist:portable": "npm run build && npm run build:portable-splash && node scripts/build-portable.cjs",
    "prestart": "node scripts/file-icons.mjs",
    "predev": "node scripts/file-icons.mjs",
    "predesktop": "node scripts/file-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-virtual": "^3.14.21",
    "fast-xml-parser": "^5.11.2",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.468.0",
    "minimatch": "^10.2.6",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "material-icon-theme": "^5.39.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.svnx.desktop",
    "productName": "SVNX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "SVNX-Setup-${version}-${arch}.exe",
    "portable": {
      "artifactName": "SVNX-${version}-win-${arch}-portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "author": "SVNX contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmibing/svnx.git"
  }
}
